# Used by @stagewise/mcp-proxy
MCP_PROXY_AGENT_TOKEN=
MCP_PROXY_ENVIRONMENT_TOKEN=

# Telegram MCP credentials resolved by Klex and sent as HTTP headers
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Local LiveKit server used by realtime adapter tests and chat-simulator calls
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Used by the ephemeral Telegram proxy
TELEGRAM_RUNTIME_IDLE_TIMEOUT_MS=5000
TELEGRAM_MEDIA_MAX_BYTES=10485760
TELEGRAM_PENDING_MEDIA_MAX_BYTES=52428800
TELEGRAM_MEDIA_DOWNLOAD_TIMEOUT_MS=15000
