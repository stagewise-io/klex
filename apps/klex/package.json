{
  "name": "@stagewise/klex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    "./admin-api": {
      "types": "./src/admin-api/index.ts",
      "default": "./src/admin-api/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx build.ts",
    "build:exe": "pnpm --filter \"@stagewise/klex^...\" build && tsx build.ts --sea && tsx scripts/package-exe.ts",
    "release:artifact": "pnpm --filter \"@stagewise/klex^...\" build && tsx build.ts --sea && tsx scripts/release/build-artifact.ts",
    "release:assemble": "tsx scripts/release/aggregate-manifest.ts",
    "release:nightly-version": "tsx scripts/release/nightly-version.ts",
    "test:exe": "pnpm run build:exe -- --skip-notarize && tsx scripts/smoke-exe.ts",
    "typecheck": "tsc --noEmit",
    "build:admin-api-types": "rm -rf .types/admin-api && tsc -p tsconfig.admin-api-types.json",
    "test": "vitest run",
    "test:livekit": "set -a; . ../../.env; set +a; vitest run src/media-transport/livekit-room/livekit-room.integration.test.ts --reporter=verbose",
    "test:openai-realtime": "set -a; . ../../.env; set +a; vitest run src/session/realtime/openai-realtime/openai-realtime.integration.test.ts --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-mjs-debug-sync": "0.32.0",
    "@opentelemetry/context-async-hooks": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@stagewise/app-packager": "workspace:*",
    "@stagewise/typescript-config": "workspace:*",
    "@types/ffmpeg-static": "5.1.0",
    "@types/fluent-ffmpeg": "2.1.27",
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "esbuild": "0.28.1",
    "livekit-server-sdk": "2.17.0",
    "rimraf": "6.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.16",
    "@ai-sdk/google": "4.0.18",
    "@ai-sdk/open-responses": "2.0.11",
    "@ai-sdk/openai": "4.0.16",
    "@ai-sdk/openai-compatible": "3.0.12",
    "@ai-sdk/provider": "4.0.3",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@hono/node-server": "2.0.10",
    "@hono/zod-openapi": "1.5.1",
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@klex/cloud-api": "link:/Users/glenntows/.stagewise/worktrees/9e2809bb39c8/sublime-charge/packages/cloud-api/dist",
    "@libsql/client": "0.17.4",
    "@livekit/rtc-node": "0.13.32",
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@stagewise/logger": "workspace:*",
    "@stagewise/mcp-extension-push-notifications": "workspace:*",
    "@stagewise/mcp-extension-realtime-media": "workspace:*",
    "ai": "7.0.31",
    "drizzle-orm": "0.45.2",
    "ffmpeg-static": "5.3.0",
    "fluent-ffmpeg": "2.1.3",
    "hono": "4.12.30",
    "jose": "6.2.10",
    "oauth4webapi": "3.8.7",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "0.35.3",
    "ws": "8.18.1",
    "zod": "4.4.3"
  },
  "keywords": [],
