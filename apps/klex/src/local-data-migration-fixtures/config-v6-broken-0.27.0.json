{
  "_klex": {
    "store": "config",
    "schemaVersion": 6,
    "compatibilityVersion": 8,
    "minimumKlexVersion": "0.18.0",
    "writtenByKlexVersion": "0.27.0"
  },
  "configVersion": 2,
  "officialName": "Frozen Upgrade Agent",
  "timezone": "UTC",
  "providers": {
    "primary": {
      "type": "openai",
      "settings": { "apiKey": "${env:PRIMARY_API_KEY}" },
      "knownModels": { "tts-1": { "kind": "text-to-speech" } }
    }
  },
  "modelSelection": {
    "chat": [
      {
        "providerId": "primary",
        "modelId": "gpt-4.1",
        "providerOptions": { "openai": { "reasoningEffort": "high" } }
      }
    ],
    "compaction": [],
    "memory": [],
    "imageVision": [],
    "audioListening": [{ "providerId": "primary", "modelId": "whisper-1" }],
    "consult": [],
    "instincts": [],
    "voice": { "sts": [{ "providerId": "primary", "modelId": "gpt-realtime" }] }
  },
  "mcpServers": {
    "workspace": {
      "command": "workspace-mcp",
      "args": ["--root", "/workspace"]
    }
  },
  "extensions": {
    "memory": {
      "episodes": {
        "maxCharacters": 50000,
        "maxDurationMs": 3600000,
        "idleTimeoutMs": 450000
      }
    }
  },
  "instinct": {
    "enabled": true,
    "timeoutMs": 8000,
    "classifierTimeoutMs": 4000,
    "historyCharacterCap": 16000,
    "messageCharacterCap": 2000,
    "contextCharacterCap": 2000
  }
}
