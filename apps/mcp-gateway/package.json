{
  "name": "@stagewise/mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "e2e:daemon": "tsx scripts/e2e-daemon.ts",
    "e2e:client": "tsx scripts/e2e-client.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@stagewise/logger": "workspace:*",
    "@stagewise/mcp-extension-fluid-events": "workspace:*",
    "@stagewise/mcp-gateway-sdk": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@10.30.3"
}
