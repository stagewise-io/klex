# Optional, public PostHog project token (never a personal API key/secret).
# Leave blank to disable telemetry. When configured, capture is automatic, without consent UI.
VITE_POSTHOG_KEY=
# Only this explicit EU ingestion origin is accepted.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Uses standard PostHog persistence, URLs, attribution, and autocapture.
# Session replay is disabled; Do Not Track and Global Privacy Control are respected.
# Vite embeds these public values at build time. See README.md for details.
