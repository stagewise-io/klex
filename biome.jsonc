{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.turbo",
      "!**/pnpm-lock.yaml",
      "!**/*.gen.ts",
      "!.agents",
      "!.impeccable"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "auto"
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": true,
            "groups": [
              { "kind": "bare" },
              ":BLANK_LINE:",
              [":NODE:", ":BUN:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@stagewise/**"],
              ":BLANK_LINE:",
              "@stagewise/**",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Desktop platform wall: only the entry point picks a provider.
      "includes": [
        "mcp-servers/klex-machine/src/**",
        "!mcp-servers/klex-machine/src/index.ts",
        "!mcp-servers/klex-machine/src/desktop/platform/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/platform", "**/platform/**"],
                    "message": "Desktop platform code is reached only through DesktopProvider; see mcp-servers/klex-machine/test/desktop-boundary.test.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "mcp-servers/klex-machine/src/desktop/*.ts",
        "mcp-servers/klex-machine/src/cloud/desktop-link.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:child_process": "Native desktop access belongs in src/desktop/platform/.",
                  "node:net": "Native desktop access belongs in src/desktop/platform/.",
                  "node:fs": "Native desktop access belongs in src/desktop/platform/.",
                  "node:fs/promises": "Native desktop access belongs in src/desktop/platform/.",
                  "node:os": "Native desktop access belongs in src/desktop/platform/."
                },
                "patterns": [
                  {
                    "group": ["**/platform", "**/platform/**"],
                    "message": "Desktop platform code is reached only through DesktopProvider; see mcp-servers/klex-machine/test/desktop-boundary.test.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
