{
  "name": "@stagewise/chat-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local chat environment MCP simulator",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.0.10",
    "@modelcontextprotocol/hono": "2.0.0-beta.4",
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "@stagewise/logger": "workspace:*",
    "@stagewise/mcp-extension-push-notifications": "workspace:*",
    "@stagewise/mcp-extension-realtime-media": "workspace:*",
    "hono": "4.12.30",
    "livekit-client": "2.21.0",
    "livekit-server-sdk": "2.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
