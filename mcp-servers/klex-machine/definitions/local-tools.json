[
  {
    "name": "read",
    "description": "Read a UTF-8 or base64 file. Access is unrestricted.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "type": "string",
          "enum": ["utf8", "base64"]
        },
        "startLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "list",
    "description": "List a directory with metadata. Access is unrestricted.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "write",
    "description": "Atomically write a UTF-8 or base64 file.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        },
        "encoding": {
          "type": "string",
          "enum": ["utf8", "base64"]
        }
      },
      "required": ["path", "content"]
    }
  },
  {
    "name": "multiEdit",
    "description": "Apply sequential exact text replacements atomically.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "edits": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "oldString": {
                "type": "string"
              },
              "newString": {
                "type": "string"
              },
              "replaceAll": {
                "type": "boolean"
              }
            },
            "required": ["oldString", "newString"]
          }
        }
      },
      "required": ["path", "edits"]
    }
  },
  {
    "name": "mkdir",
    "description": "Recursively create a directory.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "delete",
    "description": "Permanently delete a file or directory tree.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "copy",
    "description": "Copy or move a file, symlink, or directory tree.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "move": {
          "type": "boolean"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "required": ["source", "destination"]
    }
  },
  {
    "name": "glob",
    "description": "Find paths using bounded glob patterns.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "patterns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden": {
          "type": "boolean"
        },
        "gitignore": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["patterns"]
    }
  },
  {
    "name": "grepSearch",
    "description": "Search bounded text files using a regular expression.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "gitignore": {
          "type": "boolean"
        },
        "context": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["pattern"]
    }
  },
  {
    "name": "createShellSession",
    "description": "Create an unrestricted persistent PTY shell session.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "shell": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cols": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "rows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "writeShellSession",
    "description": "Write raw input to a persistent PTY session.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "data": {
          "type": "string"
        }
      },
      "required": ["id", "data"]
    }
  },
  {
    "name": "readShellSession",
    "description": "Read PTY output using a monotonic cursor.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "waitMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      },
      "required": ["id"]
    }
  },
  {
    "name": "resizeShellSession",
    "description": "Resize a persistent PTY session.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "cols": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "rows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["id", "cols", "rows"]
    }
  },
  {
    "name": "closeShellSession",
    "description": "Terminate and remove a persistent PTY session.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": ["id"]
    }
  },
  {
    "name": "listShellSessions",
    "description": "List persistent PTY sessions and exit states.",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {}
    }
  }
]
