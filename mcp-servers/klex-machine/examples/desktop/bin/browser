#!/bin/sh
# Chrome's own sandbox needs user namespaces, which Docker's default seccomp
# profile blocks. Pass KLEX_BROWSER_NO_SANDBOX=1 only inside such containers;
# the container is the boundary there.
set -eu
flags="--no-first-run --no-default-browser-check --password-store=basic --disable-dev-shm-usage --user-data-dir=${HOME}/.config/klex-browser"
if [ "${KLEX_BROWSER_NO_SANDBOX:-0}" = 1 ]; then
  flags="$flags --no-sandbox"
fi
# shellcheck disable=SC2086
exec google-chrome $flags "$@"
