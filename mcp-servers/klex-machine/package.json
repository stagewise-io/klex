{
  "name": "@klex/machine",
  "version": "0.1.0",
  "type": "module",
  "description": "Unrestricted filesystem and persistent shell MCP server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stagewise-io/klex.git",
    "directory": "mcp-servers/klex-machine"
  },
  "bin": {
    "klex-machine": "bin/klex-machine.js"
  },
  "files": [
    "bin",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "cargo test --locked --package klex-machine && node --test npm/",
    "lint": "cargo clippy --locked --package klex-machine --all-targets -- -D warnings",
    "typecheck": "cargo check --locked --package klex-machine --all-targets",
    "format": "cargo fmt --package klex-machine",
    "format:check": "cargo fmt --package klex-machine -- --check",
    "verify": "node npm/verify.mjs"
  },
  "keywords": [
    "klex",
    "mcp",
    "shell",
    "filesystem"
  ],
  "packageManager": "pnpm@11.22.0"
}
