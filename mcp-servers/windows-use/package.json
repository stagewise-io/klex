{
  "name": "@stagewise/windows-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gateway-connected Windows computer-use environment",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "build:exe": "pnpm --filter @stagewise/app-packager build && node build.mjs --sea && node ../../packages/app-packager/dist/cli/cli.js package --config app-packager.config.mjs",
    "dev": "tsx --env-file ../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stagewise/logger": "workspace:*",
    "@stagewise/mcp-proxy-sdk": "workspace:*"
  },
  "devDependencies": {
    "@stagewise/app-packager": "workspace:*",
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
