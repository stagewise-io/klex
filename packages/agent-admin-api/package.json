{
  "name": "@klex/agent-admin-api",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Shared types for the Klex Agent Admin API",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "peerDependencies": {
    "@hono/zod-openapi": "1.5.1",
    "hono": "4.12.30"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm --filter @stagewise/klex build:admin-api-types && node build.mjs",
    "typecheck": "pnpm build && tsc --noEmit",
    "verify": "pnpm build && node verify-package.mjs"
  },
  "devDependencies": {
    "@hono/zod-openapi": "1.5.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stagewise/klex": "workspace:*",
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "26.1.1",
    "hono": "4.12.30",
    "semantic-release": "25.0.9",
    "semantic-release-monorepo": "8.0.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.22.0"
}
