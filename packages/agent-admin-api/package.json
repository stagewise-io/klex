{
  "name": "@klex/agent-admin-api",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Shared types for the Klex Bot Admin API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stagewise-io/klex.git",
    "directory": "packages/agent-admin-api"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "peerDependencies": {
    "@hono/zod-openapi": "1.5.1",
    "hono": "4.12.30"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test release-config.test.mjs ../../scripts/check-package-release-scopes.test.mjs ../../scripts/scoped-release-integration.test.mjs",
    "verify": "node verify-package.mjs"
  },
  "devDependencies": {
    "@hono/zod-openapi": "1.5.1",
    "@stagewise/klex": "workspace:*",
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "26.1.1",
    "hono": "4.12.30",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.22.0"
}
