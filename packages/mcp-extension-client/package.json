{
  "name": "@stagewise/mcp-extension-client",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Shared client infrastructure for stagewise MCP extensions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stagewise-io/klex.git",
    "directory": "packages/mcp-extension-client"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build",
    "verify": "node ../../scripts/verify-mcp-extension-packages.mjs"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
