{
  "name": "@stagewise/mcp-extension-events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Events extension (SEP-3415, io.modelcontextprotocol/events) for the Model Context Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/stagewise-io/klex.git",
    "directory": "packages/mcp-extension-events"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "schema.json",
    "specification",
    "README.md"
  ],
  "scripts": {
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "check:schema": "pnpm run typecheck && tsx scripts/generate-schemas.ts --check",
    "clean": "rm -rf dist",
    "build": "pnpm run generate:schemas && pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run generate:schemas && vitest run"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.4",
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "ts-to-zod": "5.1.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
