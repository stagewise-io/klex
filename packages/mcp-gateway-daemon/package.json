{
  "name": "@stagewise/mcp-gateway-daemon",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Node.js daemon SDK for hosting MCP servers behind an MCP gateway",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "@stagewise/mcp-gateway-core": "workspace:*",
    "ws": "8.18.1"
  },
  "devDependencies": {
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
