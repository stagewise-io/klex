{
  "name": "@stagewise/mcp-proxy-sdk",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "description": "SDK for hosting MCP proxies and connecting remote MCP environments",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stagewise-io/klex.git",
    "directory": "packages/mcp-proxy-sdk"
  },
  "homepage": "https://github.com/stagewise-io/klex/tree/main/packages/mcp-proxy-sdk#readme",
  "bugs": {
    "url": "https://github.com/stagewise-io/klex/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "websocket"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./daemon/node": {
      "types": "./dist/daemon/node/index.d.ts",
      "default": "./dist/daemon/node/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "clean": "node clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0-beta.4",
    "ws": "8.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stagewise/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
