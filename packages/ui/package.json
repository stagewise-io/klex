{
  "name": "@stagewise/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Customized shadcn/ui components built on Base UI primitives, for use across stagewise projects.",
  "type": "module",
  "license": "MIT AND OFL-1.1",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./fonts/*": "./src/fonts/*",
    "./plugin": "./src/plugin/index.ts",
    "./src": "./src",
    "./src/*": "./src/*",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@stagewise/typescript-config": "workspace:*",
    "typescript": "5.9.3"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": "https://github.com/stagewise-io/cloud.git"
}
